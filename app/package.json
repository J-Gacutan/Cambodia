  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
