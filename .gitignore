.DS_Store
~$*
*.tif
*.tiff
*.tif.ovr
*.tif.aux.xml
*.nc
*.zip
*.rar
*.7z
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.xml
!**/PROVENANCE.txt
!**/checksums*.txt
!**/CHECKSUMS*
inputs/screen-layers/**/*.img
inputs/screen-layers/**/*.dat
inputs/screen-layers/L13/pytmd/
.venv/
__pycache__/
*.pyc
.beads/embeddeddolt/
.beads.gate.lock

# INTERNAL case / FLAG visualizations — keep off public tip
# (git history may still retain prior blobs; no history rewrite unless asked)
inputs/screen-layers/**/visualizations/*.png
outputs/qgis-bridge/visualizations/*.png
outputs/qgis-bridge/styles/elevation_check_flag.qml
# Staged VERRA boundaries: allow only under open-cleared delivery (non-commercial
# research overlays, redistributable=false). Keep other copies off tip.
**/project-overlap-vcs*.geojson
!delivery/open-cleared/**/project-overlap-vcs*.geojson

# App / Pages build artifacts (synced from delivery/open-cleared at build time)
app/node_modules/
app/dist/
public/khm-bundle/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
*.gpkg.gz
**/fetch.pid
**/fetch.log
